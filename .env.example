# Flask configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production

# Database (SQLite — dev; MySQL/PostgreSQL — production)
# SQLite: sqlite:///instance/lksystem.db
# ВАЖНО на проде: auth / lk / основной домен должны использовать ОДНУ БД.
# Вариант 1: один файл instance/lksystem.db в папке lk, в .env всех трёх — абсолютный путь к нему.
# Вариант 2: симлинк instance/ из auth и основного домена на lk/.../instance/
# MySQL: mysql+pymysql://user:password@localhost:3306/lksystem
# PostgreSQL: postgresql://user:password@localhost:5432/lksystem
DATABASE_URL=sqlite:///instance/lksystem.db

# External auth service (поддомены toolls-muisic-distribution.ru: auth — вход, lk — ЛК)
AUTH_SERVICE_URL=https://auth.toolls-muisic-distribution.ru
AUTH_CALLBACK_URL=https://lk.toolls-muisic-distribution.ru/auth/callback

# Smart links domain
SMART_LINK_BASE_URL=https://lk.toolls-muisic-distribution.ru/link

# Основной домен (вход: https://auth.toolls-muisic-distribution.ru, ЛК: https://lk.toolls-muisic-distribution.ru)
# APPLICATION_ROOT_URL=https://toolls-muisic-distribution.ru

# S3 Storage (optional)
S3_URL=https://s3.toolls-muisic-distribution.ru
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# Email (SMTP)
# Reg.ru: mail.hosting.reg.ru, порт 465 (SSL) или 587 (STARTTLS)
MAIL_SERVER=mail.hosting.reg.ru
MAIL_PORT=465
MAIL_USE_TLS=false
MAIL_USE_SSL=true
MAIL_USERNAME=noreply@toolls-music.ru
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=noreply@toolls-music.ru
# Email поддержки (не менять при смене домена, если указан support@toolls-music.ru)
SUPPORT_EMAIL=support@toolls-music.ru
# Коды входа администратора (не email из профиля)
ADMIN_EMAIL=l.vilyasante@icloud.com

# SMS Aero (коды авторизации по SMS). Документация: https://smsaero.ru/integration/documentation/api/
SMSAERO_EMAIL=your-email@smsaero.ru
SMSAERO_API_KEY=
# Подпись: SMS Aero (встроенная) или ваша одобренная в кабинете smsaero.ru
SMSAERO_SIGN=SMS Aero
# При ошибке SSL (CERTIFICATE_VERIFY_FAILED) на хостинге: SMSAERO_SSL_VERIFY=false
# SMSAERO_SSL_VERIFY=false

# Upload limits (in bytes)
MAX_COVER_SIZE=10485760
MAX_TRACK_SIZE=104857600
MAX_AVATAR_SIZE=5242880
MAX_NEWS_COVER_SIZE=5242880
MAX_FINANCE_FILE_SIZE=10485760
MAX_CONTRACT_SIZE=10485760

# Telegram-бот (@toolls_music_bot):
# - рассылка «О ЧП» / обновлений только пользователям с привязкой в профиле
# - статусы тикетов — индивидуально автору тикета
# - коды входа в ЛК — индивидуально тому, кто входит
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=toolls_music_bot
# Секрет в URL webhook (рекомендуется): /telegram/webhook/<secret>
TELEGRAM_WEBHOOK_SECRET=

# ЮKassa API: обязательно задать на production
YOOKASSA_SHOP_ID=1467382
YOOKASSA_SECRET_KEY=
YOOKASSA_API_URL=https://api.yookassa.ru/v3

# FTP деплоя на Reg.ru (локально; не выкладывать на сервер)
# REGRU_FTP_HOST=server159.hosting.reg.ru
# REGRU_FTP_USER=u3616355
# REGRU_FTP_PASS=
